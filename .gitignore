# Each of these is its own git repository (or an upstream clone), not tracked here.
/games/
/templates/
/tools/lpc-generator/
/tools/gamekit/node_modules/

# Generated code graph (graphify update …)
/graphify-out/
**/graphify-out/

# Editor / OS
.vscode/settings.json
.idea/
*.swp
.DS_Store
__pycache__/
/.gamekit-tools-updated

# Local venvs for tools (do not commit packages)
/tools/free-tools/venv/
/tools/gdgraph/.venv/

# Ruff cache (local runs)
/.ruff_cache/

# Sprite Lab previews are generated by `gamekit art run` and only viewed (user 2026-11-21: 1290 GIFs + previews
# bloated the repo and review diffs). Keep gen.py, strip, json, hitmask in git; regenerate the previews.
/sprite-lab/sprites/**/*.gif
/sprite-lab/sprites/**/preview.png
/sprite-lab/sprites/**/preview.png.import

# Repomix dumps: local debug only, never committed (user 2026-11-21)
/repomix-output.xml

# ComfyUI install (models ~GB, local only)
/tools/comfyui/

# Máy GPU: cấu hình riêng của từng máy, log tunnel và lease (tools/gpuhost)
/.gpu/
# ảnh AI gốc của concept (768², mờ): chỉ commit bản pixel + palette + sheet
/sprite-lab/sprites/*/concept/raw_*.png

# Design Lab reference tools (setup.sh clones them, not committed)
/design-web/vendor/
