#!/usr/bin/env bash
# Root repo pre-commit (enabled by `gamekit hooks`): a commit that touches Sprite Lab
# sprites or their shared code must pass the lab tests (lesson 2026-11-17: a sprite
# was committed while `gamekit art test` reported 1 failed, the test and the commit
# were chained with ";").
set -uo pipefail
staged="$(git diff --cached --name-only)"
if grep -qE '^sprite-lab/(sprites|lib)/' <<<"$staged"; then
  echo "pre-commit: Sprite Lab files staged -> gamekit art test" >&2
  out="$(gamekit art test 2>&1)"
  summary="$(grep -E '[0-9]+ passed, [0-9]+ failed' <<<"$out" | tail -1)"
  echo "pre-commit: ${summary:-no test summary}" >&2
  if [[ -z "$summary" || "$summary" != *" 0 failed"* ]]; then
    grep -E '^FAIL' <<<"$out" >&2
    echo "pre-commit: refused - fix the failing lab tests first" >&2
    exit 1
  fi
fi
# A sprite folder in the commit must not keep generated files untracked (lesson 2026-11-22: three new
# *_hitmask.png were left out twice; a path-limited commit only takes files already tracked).
dirs="$(grep -oE '^sprite-lab/sprites/[^/]+/' <<<"$staged" | sort -u)"
if [[ -n "$dirs" ]]; then
  # shellcheck disable=SC2086
  loose="$(git ls-files --others --exclude-standard -- $dirs | grep -vE '\.import$' || true)"
  if [[ -n "$loose" ]]; then
    echo "pre-commit: untracked files in the sprite folders being committed:" >&2
    sed 's/^/  /' <<<"$loose" >&2
    echo "pre-commit: refused - git add them (or ignore them) and commit again" >&2
    exit 1
  fi
fi
# The dashboard is one HTML file of plain JS: a syntax error blanks every tab
# (lesson 2026-11-18: a second "const st" in one scope left it on "Đang tải…").
if grep -qE '^sprite-lab/games\.html$' <<<"$staged" && command -v node >/dev/null; then
  js="$(mktemp --suffix=.js)"
  git show :sprite-lab/games.html | python3 -c 'import re,sys; print("\n".join(re.findall(r"<script>(.*?)</script>", sys.stdin.read(), re.S)))' > "$js"
  if ! err="$(node --check "$js" 2>&1)"; then
    echo "pre-commit: sprite-lab/games.html has a JavaScript syntax error:" >&2
    grep -E "SyntaxError|^\s+\^|:[0-9]+$" <<<"$err" | head -4 >&2
    rm -f "$js"
    echo "pre-commit: refused - the dashboard would not load" >&2
    exit 1
  fi
  rm -f "$js"
fi
exit 0
