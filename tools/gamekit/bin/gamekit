#!/usr/bin/env bash
# gamekit — one entry point for the game-studio workspace.
#   gamekit help
# <game> is a folder name under games/ (e.g. dom-dom-dem-mua) or a path.
# Inside a game folder it can be omitted.
set -euo pipefail

KIT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
WS="$(cd "$KIT/../.." && pwd)"                       # workspace root (game-studio/)
TEMPLATE="$WS/templates/claude-code-game-studios"
LPC_DIR="$WS/tools/lpc-generator"
LAB="$WS/sprite-lab"
UPSTREAM="https://github.com/Donchitos/Claude-Code-Game-Studios.git"
GODOT="${GODOT:-godot}"
LIBRESPRITE="${LIBRESPRITE:-libresprite}"
RUN=(); command -v limited >/dev/null 2>&1 && RUN=(limited)   # machine rule: keep 10% free
VERSION="$(cat "$KIT/VERSION")"

die() { echo "gamekit: $*" >&2; exit 1; }
say() { printf '\033[1m== %s\033[0m\n' "$*"; }

# Resolve <game> to an absolute folder holding project.godot.
resolve_game() {
  local arg="${1:-}" d
  if [[ -z "$arg" ]]; then
    d="$PWD"
    while [[ "$d" != / ]]; do [[ -f "$d/project.godot" ]] && { echo "$d"; return; }; d="$(dirname "$d")"; done
    die "no <game> given and not inside a game folder (gamekit list)"
  fi
  for d in "$arg" "$WS/games/$arg"; do
    [[ -f "$d/project.godot" ]] && { (cd "$d" && pwd); return; }
  done
  die "game not found: $arg (gamekit list)"
}

godot_import() { "${RUN[@]}" "$GODOT" --headless --path "$1" --import >/dev/null 2>&1 || true; }

cmd_help() {
  cat <<EOF
gamekit $VERSION — workspace: $WS

Project
  list                         games in games/, with version and engine
  new <slug> ["Title"]         new game from the framework template (+ Godot, gamekit addon, export presets)
  install <game>               (re)install the gamekit addon, presets, Makefile into a game
  tidy <game>                  move framework repo files out of a game (README, CHANGELOG, .github, ...)
  update-template              git pull the framework template (templates/claude-code-game-studios)
  doctor                       check every tool the kit needs (and the agent links)
  agents-link [--check]        link AGENTS.md + .agents/skills for every agent (Claude, OpenCode, Codex, …)

Play and test
  run <game>                   play
  edit <game>                  open the Godot editor
  test <game>                  import + unit/integration tests (exit 1 on failure)
  shot <game> [scene] [frames] [-- args]  run windowed, save the last frame to <game>/builds/shots/

Sprites (LPC)
  lpc                          start the LPC character generator (http://localhost:5173)
  sprites <game>               assets/source/lpc/*.zip|png -> SpriteFrames + merged credits
  sample-sprite <game>         compose a sample character offline (no browser)
  preview <game> [character]   character viewer

Sprite Lab (sprite-lab/: make + test sprites here, then promote into a game)
  art new <name> [--size N]         scaffold sprite-lab/sprites/<name>/gen.py
  art rig new <name> [hero|hero-sword|knight] create an editable Pixelbolt pose source
  art rig validate|inspect|motion|build <name> author, review, or import a rigged character
  art run <name>                    render + check metadata (frames, animations, anchor)
  art lab [<name>] [sheet|move]     open the lab: all animations / a movement test stage
  art shot <name> [sheet|move] [frames]  screenshot the lab (move = scripted demo) for review
  art list | art check | art test   sprites + which games use them / validate all / lab tests
  art promote <name> <game>         copy strip + json into games/<g>/assets/sprites/custom/<name>/
  art ase|open <name>               .ase for editing by hand in LibreSprite

Release
  templates                    install Godot export templates (once per Godot version)
  export <game> [preset...]    tests, then Linux/Windows/Web -> <game>/builds/dist/*.zip
  smoke-web <game>             load the Web build in headless Chrome, print console, screenshot
EOF
}

cmd_list() {
  local g
  for g in "$WS"/games/*/; do
    [[ -f "$g/project.godot" ]] || continue
    local v; v="$(sed -n 's/^config\/version="\(.*\)"/\1/p' "$g/project.godot")"
    local t; t="$(sed -n 's/^config\/name="\(.*\)"/\1/p' "$g/project.godot")"
    local k=""; [[ -f "$g/addons/gamekit/VERSION" ]] && k="gamekit $(cat "$g/addons/gamekit/VERSION")"
    printf '  %-24s %-8s %-28s %s\n' "$(basename "$g")" "${v:--}" "$t" "$k"
  done
}

cmd_doctor() {
  local ok=1
  check() { if eval "$2" >/dev/null 2>&1; then printf '  ok    %-22s %s\n' "$1" "$(eval "$3" 2>/dev/null | head -1)"; else printf '  MISS  %-22s %s\n' "$1" "$4"; ok=0; fi; }
  check godot "command -v $GODOT" "$GODOT --version 2>/dev/null | tail -1" "install Godot 4.7.2 (~/.local/bin/godot)"
  local ver; ver="$("$GODOT" --version 2>/dev/null | tail -n1 | cut -d. -f1-4)"
  check "export templates" "test -d ${XDG_DATA_HOME:-$HOME/.local/share}/godot/export_templates/$ver" "echo $ver" "gamekit templates"
  check python3+PIL "python3 -c 'import PIL'" "python3 --version" "pip install pillow"
  check libresprite "command -v $LIBRESPRITE" "$LIBRESPRITE --version 2>/dev/null | head -1" "install LibreSprite 1.3 (~/.local/bin/libresprite)"
  check node-20 "command -v node && node -e 'process.exit(Number(process.versions.node.split(\".\")[0]) >= 20 ? 0 : 1)'" "node --version" "install Node.js 20 or newer"
  check pixelbolt "test -f $KIT/node_modules/pixelbolt/bin/pixelbolt.js" "node -p \"require('$KIT/node_modules/pixelbolt/package.json').version\"" "npm ci --prefix tools/gamekit"
  check chrome "command -v google-chrome || command -v chromium" "command -v google-chrome || command -v chromium" "needed for smoke-web"
  check zip "command -v zip" "echo zip" "apt install zip"
  check rsync "command -v rsync" "echo rsync" "apt install rsync"
  check limited "command -v limited" "echo ~/.local/bin/limited" "heavy jobs will run unlimited"
  check "framework template" "test -f $TEMPLATE/CLAUDE.md" "git -C $TEMPLATE log --oneline -1" "git clone $UPSTREAM $TEMPLATE"
  check "lpc generator" "test -f $LPC_DIR/package.json" "git -C $LPC_DIR log --oneline -1" "git clone the generator into tools/lpc-generator"
  [[ -d "$LPC_DIR/node_modules" ]] || printf '  note  %-22s %s\n' "lpc node_modules" "not installed yet - the first 'gamekit lpc' runs npm ci"
  cmd_agents_link --check || { ok=0; echo "        fix: gamekit agents-link"; }
  [[ $ok == 1 ]]
}

cmd_install() {
  local game; game="$(resolve_game "${1:-}")"
  local slug; slug="$(basename "$game")"
  say "install gamekit $VERSION -> $game"
  mkdir -p "$game/addons/gamekit"
  rsync -a --delete --exclude '*.uid' --exclude '*.import' "$KIT/addon/gamekit/" "$game/addons/gamekit/"
  cp "$KIT/VERSION" "$game/addons/gamekit/VERSION"
  [[ -f "$game/export_presets.cfg" ]] || sed "s/__SLUG__/$slug/g" "$KIT/templates/export_presets.cfg" > "$game/export_presets.cfg"
  [[ -f "$game/Makefile" ]] || cp "$KIT/templates/Makefile" "$game/Makefile"
  # Godot must not import the framework's docs, tools and raw art drops.
  # Only folders that exist: never recreate one that `tidy` removed (studio-tests).
  mkdir -p "$game/assets/source/lpc" "$game/assets/data"
  local d; for d in .claude docs design studio-tests production assets/source; do
    [[ -d "$game/$d" && ! -f "$game/$d/.gdignore" ]] && : > "$game/$d/.gdignore"
  done
  # The template ignores export_presets.cfg and *.zip. Godot 4 keeps signing
  # secrets in .godot/export_credentials.cfg, so the presets are safe to commit,
  # and the LPC source zips are the art's source of truth.
  local line; for line in ".godot/" "builds/" "!export_presets.cfg" "!assets/source/lpc/*.zip"; do
    grep -qxF "$line" "$game/.gitignore" 2>/dev/null || printf '%s\n' "$line" >> "$game/.gitignore"
  done
  echo "   addon, export_presets.cfg, Makefile, .gdignore files ready"
}

# Strip the framework repo's own meta files out of a game, so the game folder
# holds only the game plus what the framework needs to run. The template keeps
# the originals (templates/claude-code-game-studios).
FRAMEWORK_META=(CHANGELOG.md CONTRIBUTING.md SECURITY.md UPGRADING.md .github studio-tests
  docs/WORKFLOW-GUIDE.md docs/skill-flow-diagrams.md docs/migration-guide-v1.1.md)
cmd_tidy() {
  local game; game="$(resolve_game "${1:-}")"
  local title; title="$(sed -n 's/^config\/name="\(.*\)"/\1/p' "$game/project.godot")"
  say "tidy $game (framework meta out, game README in)"
  local f; for f in "${FRAMEWORK_META[@]}"; do
    [[ -e "$game/$f" ]] && { rm -rf "${game:?}/$f"; echo "   removed $f (still in the template)"; }
  done
  if [[ -f "$game/LICENSE" ]] && grep -q "Claude Code Game Studios\|Donchitos" "$game/LICENSE"; then
    mkdir -p "$game/LICENSES"; mv "$game/LICENSE" "$game/LICENSES/claude-code-game-studios-MIT.txt"
    echo "   LICENSE -> LICENSES/claude-code-game-studios-MIT.txt (MIT notice must stay)"
  fi
  if [[ ! -f "$game/README.md" ]] || head -5 "$game/README.md" | grep -q "Claude Code Game Studios"; then
    sed "s/__TITLE__/${title:-$(basename "$game")}/g" "$KIT/templates/README.game.md" > "$game/README.md"
    echo "   README.md -> game README (fill it in)"
  fi
  # A "## This game" block at the top of CLAUDE.md: pointers + the commit rule.
  if [[ -f "$game/CLAUDE.md" ]] && ! grep -q '^## This game' "$game/CLAUDE.md"; then
    SECTION="$(sed "s/__TITLE__/${title:-$(basename "$game")}/g" "$KIT/templates/CLAUDE.game-section.md")" \
      awk 'done==0 && /^## / {print ENVIRON["SECTION"]; print ""; done=1} {print}' \
      "$game/CLAUDE.md" > "$game/CLAUDE.md.tmp" && mv "$game/CLAUDE.md.tmp" "$game/CLAUDE.md"
    echo "   CLAUDE.md: added '## This game' (pointers + commit rule)"
  fi
  agents_link_game 0 "$game"
  # origin pointed at the framework; keep it as 'framework' so 'origin' is free for the game's own remote.
  if [[ "$(git -C "$game" remote get-url origin 2>/dev/null)" == "$UPSTREAM" ]]; then
    git -C "$game" remote rename origin framework
    echo "   git remote origin -> framework (add your own: git remote add origin <url>)"
  fi
}

# --- agent config shared by every AI agent ------------------------------------
# One source of truth per thing, links for each agent:
#   instructions  AGENTS.md            <- CLAUDE.md (@AGENTS.md import)
#   skills        .agents/skills/<n>/  <- .claude/skills/<n> (symlink); OpenCode/Codex read .agents/ directly
# In a game: AGENTS.md (from template) points at the framework's CLAUDE.md, and
# .agents/skills -> .claude/skills exposes the framework skills to non-Claude agents.
AGENT_PROBLEMS=0
_agent_fix() {  # _agent_fix <check-only 0|1> <message> <command...>
  local check="$1" msg="$2"; shift 2
  if [[ "$check" == 1 ]]; then printf '  MISS  %s\n' "$msg"; AGENT_PROBLEMS=$((AGENT_PROBLEMS + 1))
  else "$@"; printf '   fixed %s\n' "$msg"; fi
}
_symlink_ok() { [[ -L "$1" && "$(readlink "$1")" == "$2" ]]; }

agents_link_workspace() {
  local check="$1" n
  [[ -f "$WS/AGENTS.md" ]] || die "missing $WS/AGENTS.md (the shared instructions)"
  grep -qx '@AGENTS.md' "$WS/CLAUDE.md" 2>/dev/null \
    || _agent_fix "$check" "CLAUDE.md must import @AGENTS.md" \
         sh -c "{ printf '@AGENTS.md\n\n'; cat '$WS/CLAUDE.md' 2>/dev/null; } > '$WS/CLAUDE.md.tmp' && mv '$WS/CLAUDE.md.tmp' '$WS/CLAUDE.md'"
  mkdir -p "$WS/.agents/skills"
  for n in "$WS"/.agents/skills/*/; do
    [[ -f "$n/SKILL.md" ]] || continue
    n="$(basename "$n")"
    local dest="$WS/.claude/skills/$n" target="../../.agents/skills/$n"
    [[ -e "$dest" && ! -L "$dest" ]] && die ".claude/skills/$n is a real folder; move it to .agents/skills/$n"
    _symlink_ok "$dest" "$target" \
      || _agent_fix "$check" ".claude/skills/$n -> $target" sh -c "mkdir -p '$WS/.claude/skills' && ln -sfn '$target' '$dest'"
  done
  for n in "$WS"/.claude/skills/*; do        # links whose skill was removed
    [[ -L "$n" && ! -e "$n" ]] && _agent_fix "$check" "stale link .claude/skills/$(basename "$n")" rm -f "$n"
  done
  return 0
}

agents_link_game() {
  local check="$1" game="$2"
  local title; title="$(sed -n 's/^config\/name="\(.*\)"/\1/p' "$game/project.godot")"
  local tag; tag="games/$(basename "$game")"
  [[ -f "$game/AGENTS.md" ]] \
    || _agent_fix "$check" "$tag/AGENTS.md" \
         sh -c "sed 's/__TITLE__/${title:-$(basename "$game")}/g' '$KIT/templates/AGENTS.game.md' > '$game/AGENTS.md'"
  if [[ -d "$game/.claude/skills" ]]; then
    [[ -e "$game/.agents/skills" && ! -L "$game/.agents/skills" ]] && die "$tag/.agents/skills is a real folder"
    _symlink_ok "$game/.agents/skills" ../.claude/skills \
      || _agent_fix "$check" "$tag/.agents/skills -> ../.claude/skills" \
           sh -c "mkdir -p '$game/.agents' && ln -sfn ../.claude/skills '$game/.agents/skills'"
  fi
  return 0
}

cmd_agents_link() {
  local check=0; [[ "${1:-}" == "--check" ]] && check=1
  [[ $check == 1 ]] || say "agent config (AGENTS.md + .agents/skills, linked for every agent)"
  agents_link_workspace "$check"
  local g; for g in "$WS"/games/*/; do [[ -f "$g/project.godot" ]] && agents_link_game "$check" "${g%/}"; done
  if [[ $check == 1 ]]; then
    [[ $AGENT_PROBLEMS == 0 ]] && echo "  ok    agent config (AGENTS.md, skills linked)"
    return $(( AGENT_PROBLEMS > 0 ))
  fi
  echo "   skills: $(ls "$WS/.agents/skills" | tr '\n' ' ')"
}

cmd_new() {
  local slug="${1:-}" title="${2:-}"
  [[ "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "slug must be lowercase-kebab, e.g. space-miner"
  local game="$WS/games/$slug"
  [[ -e "$game" ]] && die "$game already exists"
  [[ -f "$TEMPLATE/CLAUDE.md" ]] || die "framework template missing: $TEMPLATE"
  title="${title:-$slug}"
  say "new game $slug from template ($(git -C "$TEMPLATE" log --oneline -1))"
  git clone -q "$TEMPLATE" "$game"
  git -C "$game" remote set-url origin "$UPSTREAM"
  sed "s/__TITLE__/$title/" "$KIT/templates/project.godot" > "$game/project.godot"
  cmd_install "$game"
  cmd_tidy "$game"
  local gver; gver="$("$GODOT" --version 2>/dev/null | tail -n1 | cut -d. -f1-3)"
  if ! grep -q '^engine:' "$game/project.yaml"; then
    cat >> "$game/project.yaml" <<EOF

engine:
  name: "Godot"
  version: "$gver"
  language: "GDScript"
  rendering: "Compatibility"
  physics: "Godot Physics 2D"

specialists:
  code: godot-gdscript-specialist
  shader: godot-shader-specialist
  ui: godot-specialist
  additional: [godot-gdextension-specialist]

commands:
  run: "gamekit run"
  test: "gamekit test"
  build: "gamekit export"
  sprites: "gamekit sprites"
EOF
  fi
  sed -i \
    -e "s|^- \*\*Engine\*\*: \[CHOOSE:.*|- **Engine**: Godot $gver (Compatibility renderer, 2D)|" \
    -e 's|^- \*\*Language\*\*: \[CHOOSE:.*|- **Language**: GDScript|' \
    -e 's|^- \*\*Build System\*\*: \[SPECIFY.*|- **Build System**: `gamekit export` (presets in export_presets.cfg: Linux, Windows, Web)|' \
    -e 's|^- \*\*Asset Pipeline\*\*: \[SPECIFY.*|- **Asset Pipeline**: `gamekit sprites` for LPC characters; tuning data in assets/data/*.json. See ../../tools/gamekit/README.md|' \
    "$game/CLAUDE.md"
  godot_import "$game"
  echo
  echo "Next:  cd games/$slug and open your agent (claude, opencode, codex, …); start with /start or /prototype"
}

cmd_update_template() {
  say "update framework template"
  git -C "$TEMPLATE" pull --ff-only
  echo "Existing games are not changed; see the template's UPGRADING.md to bring one up to date."
}

cmd_run()  { local g; g="$(resolve_game "${1:-}")"; "$GODOT" --path "$g"; }
cmd_edit() { local g; g="$(resolve_game "${1:-}")"; "$GODOT" -e --path "$g"; }

cmd_test() {
  local g; g="$(resolve_game "${1:-}")"
  [[ -f "$g/addons/gamekit/test/run_tests.gd" ]] || die "no test runner - gamekit install $g"
  godot_import "$g"
  "${RUN[@]}" "$GODOT" --headless --path "$g" -s res://addons/gamekit/test/run_tests.gd 2>&1 | grep -v -i fontconfig
  return "${PIPESTATUS[0]}"
}

cmd_shot() {
  local g; g="$(resolve_game "${1:-}")"; shift || true
  local scene="" frames=120 extra=()
  [[ $# -gt 0 && "$1" != "--" ]] && { scene="$1"; shift; }
  [[ $# -gt 0 && "$1" != "--" ]] && { frames="$1"; shift; }
  [[ "${1:-}" == "--" ]] && { shift; extra=(-- "$@"); }
  local tmp out; tmp="$(mktemp -d)"; mkdir -p "$g/builds/shots"
  out="$g/builds/shots/$(date +%Y%m%d-%H%M%S).png"
  "${RUN[@]}" "$GODOT" --path "$g" --windowed --resolution 1280x720 --write-movie "$tmp/f.png" \
    --quit-after "$frames" $scene "${extra[@]}" 2>&1 | grep -E "ERROR|Run over" >&2 || true  # stdout = path only
  local last; last="$(ls "$tmp"/f*.png 2>/dev/null | sort | tail -1)"
  [[ -n "$last" ]] || { rm -rf "$tmp"; die "no frame captured"; }
  cp "$last" "$out"; rm -rf "$tmp"
  echo "$out"
}

cmd_lpc() {
  [[ -f "$LPC_DIR/package.json" ]] || die "generator missing: $LPC_DIR"
  cd "$LPC_DIR"
  [[ -d node_modules ]] || { say "npm ci (first run)"; npm ci; }
  npm run dev
}

cmd_sprites() {
  local g; g="$(resolve_game "${1:-}")"
  say "ingest assets/source/lpc"
  python3 "$KIT/pipeline/lpc_ingest.py" --game "$g"
  say "import"
  godot_import "$g"
  say "build SpriteFrames"
  "${RUN[@]}" "$GODOT" --headless --path "$g" -s res://addons/gamekit/lpc/build_sprite_frames.gd 2>&1 | grep -E "^OK|ERROR|No "
  return "${PIPESTATUS[0]}"
}

cmd_sample_sprite() {
  local g; g="$(resolve_game "${1:-}")"
  python3 "$KIT/pipeline/lpc_sample_compose.py" --generator "$LPC_DIR" --name sample_hero \
    --out "$g/assets/source/lpc/sample_hero.zip"
  echo "Now: gamekit sprites $(basename "$g")"
}

cmd_preview() {
  local g; g="$(resolve_game "${1:-}")"
  local args=(); [[ -n "${2:-}" ]] && args=(-- "--character=$2")
  "$GODOT" --path "$g" res://addons/gamekit/debug/character_viewer.tscn "${args[@]}"
}

# --- Sprite Lab -------------------------------------------------------------------
# Every sprite is made and tested in sprite-lab/ (its own Godot project), never
# inside a game: `art new` refuses a game (lesson 2026-11-16, LESSONS.md).
# A finished sprite goes into a game with `art promote <name> <game>`.

lab_install() {
  [[ -f "$LAB/project.godot" ]] || die "sprite lab missing: $LAB"
  mkdir -p "$LAB/addons/gamekit" "$LAB/sprites" "$LAB/builds"
  rsync -a --delete --exclude '*.uid' --exclude '*.import' "$KIT/addon/gamekit/" "$LAB/addons/gamekit/"
  cp "$KIT/VERSION" "$LAB/addons/gamekit/VERSION"
}

lab_ready() {  # addon present and current, project imported
  if [[ ! -f "$LAB/addons/gamekit/VERSION" || "$(cat "$LAB/addons/gamekit/VERSION")" != "$VERSION" ]]; then
    lab_install
  fi
  # Always re-import: a running Godot uses the textures imported earlier, so a strip
  # that gen.py just rewrote would show the OLD art next to the NEW json (lesson
  # 2026-11-16: a review screenshot showed the previous swordsman, sliced wrong).
  godot_import "$LAB"
}

art_name() {
  local n="${1:-}"
  [[ -n "$n" ]] || die "missing sprite name (gamekit art list)"
  if [[ -f "$WS/games/$n/project.godot" || -f "$n/project.godot" ]]; then
    die "sprites are made in the Sprite Lab, not inside a game: gamekit art $ART_SUB <name>; then gamekit art promote <name> $n"
  fi
  [[ "$n" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "sprite name must be lowercase-kebab (e.g. light-mote)"
  echo "$n"
}

art_check_one() {  # validate sprite-lab/sprites/<n>/<n>.json against its strip
  local n="$1" d="$LAB/sprites/$1"
  [[ -f "$d/$n.json" ]] || die "no $n.json in sprite-lab/sprites/$n: gen.py must call write_meta / write_anim_meta"
  [[ -f "$d/${n}_strip.png" ]] || die "no ${n}_strip.png in sprite-lab/sprites/$n"
  GAMEKIT_PIPELINE="$KIT/pipeline" python3 -c '
import json, os, sys
sys.path.insert(0, os.environ["GAMEKIT_PIPELINE"])
from PIL import Image
from spritekit import check_meta, check_ground, check_hitbox
m = json.load(open(sys.argv[1]))
check_meta(m, Image.open(sys.argv[2]).size)
ground = check_ground(m, Image.open(sys.argv[2]).convert("RGBA"))
if ground:
    sys.exit("ground: " + "; ".join(ground))
hit = check_hitbox(m, Image.open(sys.argv[2]).convert("RGBA"))
if hit:
    sys.exit("hitbox: " + "; ".join(hit))
anims = m.get("animations") or [{"name": "default", "frames": m["frames"], "fps": m["fps"], "loop": m.get("loop", True)}]
print("   %-12s %2d frame %sx%s  neo %s (%s)" % (sys.argv[3], m["frames"], *m["frame_size"], m["anchor"], m["anchor_source"]))
print("                " + ", ".join("%s:%d@%sfps%s" % (a["name"], a["frames"], a["fps"], "" if a.get("loop", True) else " 1x") for a in anims))
' "$d/$n.json" "$d/${n}_strip.png" "$n" || die "bad sprite-lab/sprites/$n/$n.json"
}

art_rig() {
  local action="${1:-}"; shift || true
  local n source pb
  pb="$KIT/node_modules/pixelbolt/bin/pixelbolt.js"
  [[ -f "$pb" ]] || die "Pixelbolt is missing; run npm ci --prefix tools/gamekit"
  command -v node >/dev/null 2>&1 || die "Pixelbolt needs Node.js 20 or newer"
  case "$action" in
    new)
      n="$(art_name "${1:-}")"
      local template="${2:-hero-sword}" src="$LAB/sprites/$n"
      [[ "$template" == "hero" || "$template" == "hero-sword" || "$template" == "knight" ]] || die "pose template must be hero, hero-sword, or knight"
      [[ ! -f "$src/$n.poses.json" ]] || die "already exists: sprite-lab/sprites/$n/$n.poses.json"
      GAMEKIT_PIPELINE="$KIT/pipeline" python3 "$KIT/pipeline/pixelbolt_bridge.py" scaffold \
        --name "$n" --template "$template" --examples "$(dirname "$pb")/../examples" --out-dir "$src"
      echo "Edit sprite-lab/sprites/$n/$n.poses.json, then run: gamekit art rig validate $n"
      ;;
    validate)
      n="$(art_name "${1:-}")"; source="$LAB/sprites/$n/$n.poses.json"
      [[ -f "$source" ]] || die "no pose source: $source (gamekit art rig new $n)"
      local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/gamekit-pixelbolt-check.XXXXXX")"
      trap "rm -rf '$tmp'" EXIT
      node "$pb" compile "$source" --out "$tmp/$n.pixel.json" --metadata "$tmp/compile.json"
      node "$pb" validate "$tmp/$n.pixel.json"
      ;;
    inspect|motion)
      n="$(art_name "${1:-}")"; shift || true
      source="$LAB/sprites/$n/$n.poses.json"
      [[ -f "$source" ]] || die "no pose source: $source (gamekit art rig new $n)"
      mkdir -p "$LAB/builds/inspections"
      local out="$LAB/builds/inspections/$(date +%Y%m%d-%H%M%S)-$n-$action.png"
      if [[ "$action" == "motion" ]]; then
        local animation="${1:-walk}" speed="${2:-24}"
        [[ "$speed" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "speed must be a positive number in pixels per second"
        [[ "$speed" != "0" && "$speed" != "0.0" ]] || die "speed must be greater than zero"
        node "$pb" inspect "$source" --motion "$animation" --speed "$speed" --out "$out"
      else
        local animation="${1:-}"
        local args=(--view onion --native --diagnostics --out "$out")
        [[ -z "$animation" ]] || args+=(--animation "$animation")
        node "$pb" inspect "$source" "${args[@]}"
      fi
      echo "$out"
      ;;
    build)
      n="$(art_name "${1:-}")"; source="$LAB/sprites/$n/$n.poses.json"
      [[ -f "$source" ]] || die "no pose source: $source (gamekit art rig new $n)"
      local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/gamekit-pixelbolt.XXXXXX")"
      trap "rm -rf '$tmp'" EXIT
      node "$pb" compile "$source" --out "$tmp/$n.pixel.json" --metadata "$tmp/compile.json"
      node "$pb" render "$tmp/$n.pixel.json" --out "$tmp/render" --gif-scale 4 >/dev/null
      GAMEKIT_PIPELINE="$KIT/pipeline" python3 "$KIT/pipeline/pixelbolt_bridge.py" import \
        --name "$n" --atlas "$tmp/render/$n.atlas.json" --sheet "$tmp/render/$n.png" \
        --out-dir "$LAB/sprites/$n"
      art_check_one "$n"
      # keep the web viewer's manifest current (image URLs carry ?v=<mtime>)
      [[ -f "$LAB/build_manifest.py" ]] && python3 "$LAB/build_manifest.py" --quiet
      echo "   preview: sprite-lab/sprites/$n/preview.png"
      ;;
    *) die "usage: gamekit art rig new <name> [hero|hero-sword|knight] | validate <name> | inspect <name> [animation] | motion <name> <animation> [speed] | build <name>" ;;
  esac
}

cmd_art() {
  ART_SUB="${1:-}"; shift || true
  local n
  case "$ART_SUB" in
    new)
      n="$(art_name "${1:-}")"; shift
      local size=32
      if [[ "${1:-}" == "--size" ]]; then size="${2:-}"; fi
      [[ "$size" =~ ^[0-9]+$ ]] && (( size >= 8 && size <= 256 )) || die "--size must be 8..256"
      local src="$LAB/sprites/$n"
      [[ -e "$src/gen.py" || -e "$src/$n.poses.json" ]] && die "already exists: sprite-lab/sprites/$n"
      mkdir -p "$src"
      sed -e "s/__NAME__/$n/g" -e "s/__SIZE__/$size/g" "$KIT/templates/sprite/gen.py" > "$src/gen.py"
      chmod +x "$src/gen.py"
      echo "   sprite-lab/sprites/$n/gen.py"
      echo "Next:  gamekit art run $n   then   gamekit art lab $n"
      ;;
    run)
      n="$(art_name "${1:-}")"
      if [[ -f "$LAB/sprites/$n/$n.poses.json" ]]; then
        art_rig build "$n"
        return
      fi
      [[ -f "$LAB/sprites/$n/gen.py" ]] || die "no sprite-lab/sprites/$n/gen.py (gamekit art new $n)"
      say "render $n"
      (cd "$LAB/sprites/$n" && python3 gen.py) >/dev/null
      art_check_one "$n"
      # keep the web viewer's manifest current (image URLs carry ?v=<mtime>)
      [[ -f "$LAB/build_manifest.py" ]] && python3 "$LAB/build_manifest.py" --quiet
      echo "   preview: sprite-lab/sprites/$n/preview.png"
      ;;
    check)
      local any=0 d
      for d in "$LAB"/sprites/*/; do
        [[ -f "$d/gen.py" || -f "$d/$(basename "$d").poses.json" ]] || continue
        any=1; art_check_one "$(basename "$d")"
      done
      [[ $any == 1 ]] || echo "   (no sprites yet: gamekit art new <name>)"
      ;;
    list)
      local d g
      for d in "$LAB"/sprites/*/; do
        [[ -f "$d/gen.py" || -f "$d/$(basename "$d").poses.json" ]] || continue
        n="$(basename "$d")"
        local where=""
        for g in "$WS"/games/*/; do
          [[ -f "$g/assets/sprites/custom/$n/$n.json" ]] && where+=" $(basename "$g")"
        done
        local anims; anims="$(python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); print(",".join(a["name"] for a in m.get("animations") or [{"name":"default"}]))' "$d/$n.json" 2>/dev/null || echo "(chưa run)")"
        printf '  %-14s %-44s %s\n' "$n" "$anims" "${where:+trong game:$where}"
      done
      ;;
    rig) art_rig "$@" ;;
    lab)
      lab_ready
      local args=()
      [[ -n "${1:-}" ]] && args+=("--sprite=$(art_name "$1")")
      [[ -n "${2:-}" ]] && args+=("--mode=$2")
      "$GODOT" --path "$LAB" res://lab/sprite_lab.tscn -- "${args[@]}"
      ;;
    shot)  # art shot <name> [sheet|move] [frames] [-- extra lab args]
      n="$(art_name "${1:-}")"; shift
      local mode="${1:-sheet}"; [[ $# -gt 0 ]] && shift
      local frames="${1:-150}"; [[ $# -gt 0 && "$1" != "--" ]] && shift
      [[ "${1:-}" == "--" ]] && shift
      lab_ready
      if [[ "$mode" != "move" ]]; then
        cmd_shot "$LAB" res://lab/sprite_lab.tscn "$frames" -- --sprite="$n" --mode="$mode" "$@"
        return
      fi
      # Movement is not one picture: the lab plays its scripted demo and grabs the
      # moments it knows matter (walk, attack, run left, jump, spell, hurt…) into one
      # grid image (--contact), so one look shows the sprite in motion.
      mkdir -p "$LAB/builds/shots"
      local out; out="$LAB/builds/shots/$(date +%Y%m%d-%H%M%S)-$n-move.png"
      "${RUN[@]}" "$GODOT" --path "$LAB" --windowed --resolution 1280x720 --fixed-fps 60 \
        res://lab/sprite_lab.tscn -- --sprite="$n" --contact="$out" "$@" 2>&1 | grep -E "ERROR" >&2 || true
      [[ -f "$out" ]] || die "lab wrote no contact sheet"
      echo "$out"
      ;;
    promote)  # art promote <name> <game>
      n="$(art_name "${1:-}")"
      local g; g="$(resolve_game "${2:-}")"
      art_check_one "$n" >/dev/null
      local dest="$g/assets/sprites/custom/$n"
      mkdir -p "$dest"
      cp "$LAB/sprites/$n/${n}_strip.png" "$LAB/sprites/$n/$n.png" "$dest/" 2>/dev/null || cp "$LAB/sprites/$n/${n}_strip.png" "$dest/"
      # The copy records where it came from; the source stays in the lab only.
      python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); m["source"]="sprite-lab/sprites/"+sys.argv[3]; open(sys.argv[2],"w").write(json.dumps(m, indent=2)+"\n")' \
        "$LAB/sprites/$n/$n.json" "$dest/$n.json" "$n"
      echo "   ${dest#"$WS"/}/  (strip, json; source: sprite-lab/sprites/$n)"
      echo "Next:  use it in the game, gamekit test $(basename "$g"), gamekit shot, then commit both repos"
      ;;
    ase)
      n="$(art_name "${1:-}")"
      local png="$LAB/sprites/$n/${n}_strip.png" ase="$LAB/sprites/$n/$n.ase"
      [[ -f "$png" ]] || die "missing sprite-lab/sprites/$n/${n}_strip.png (gamekit art run $n)"
      command -v "$LIBRESPRITE" >/dev/null 2>&1 || die "libresprite not found (gamekit doctor)"
      GAMEKIT_PIPELINE="$KIT/pipeline" LIBRESPRITE="$LIBRESPRITE" python3 -c \
        'import os,sys; sys.path.insert(0,os.environ["GAMEKIT_PIPELINE"]); from spritekit import to_ase; to_ase(sys.argv[1],sys.argv[2])' \
        "$png" "$ase"
      echo "   sprite-lab/sprites/$n/$n.ase"
      ;;
    open)
      n="$(art_name "${1:-}")"
      cmd_art ase "$n"
      "$LIBRESPRITE" "$LAB/sprites/$n/$n.ase"
      ;;
    test)
      lab_ready
      cmd_test "$LAB"
      ;;
    *) die "usage: gamekit art new|rig|run|lab|shot|check|list|promote|ase|open|test ... (gamekit help)" ;;
  esac
}

cmd_templates() { GODOT="$GODOT" "$KIT/build/install_export_templates.sh"; }

cmd_export() {
  local g; g="$(resolve_game "${1:-}")"; shift || true
  GODOT="$GODOT" "$KIT/build/export.sh" "$g" "$@"
}

cmd_smoke_web() { local g; g="$(resolve_game "${1:-}")"; "$KIT/build/smoke_web.sh" "$g" "${2:-30000}"; }

sub="${1:-help}"; shift || true
case "$sub" in
  help|-h|--help) cmd_help ;;
  list) cmd_list ;;
  doctor) cmd_doctor ;;
  new) cmd_new "$@" ;;
  install) cmd_install "$@" ;;
  tidy) cmd_tidy "$@" ;;
  agents-link) cmd_agents_link "$@" ;;
  update-template) cmd_update_template ;;
  run) cmd_run "$@" ;;
  edit) cmd_edit "$@" ;;
  test) cmd_test "$@" ;;
  shot) cmd_shot "$@" ;;
  lpc) cmd_lpc ;;
  sprites) cmd_sprites "$@" ;;
  sample-sprite) cmd_sample_sprite "$@" ;;
  preview) cmd_preview "$@" ;;
  art) cmd_art "$@" ;;
  templates) cmd_templates ;;
  export) cmd_export "$@" ;;
  smoke-web) cmd_smoke_web "$@" ;;
  *) die "unknown command: $sub (gamekit help)" ;;
esac
